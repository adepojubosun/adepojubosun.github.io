---
import '../styles/global.css';
import { publishedSocials } from '../data/socials.js';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// On the landing page the nav anchors are plain fragments, exactly as in the
// original markup. On any other page they have to travel home first.
const home = Astro.url.pathname === '/' ? '' : '/';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
<link rel="alternate" type="application/rss+xml" title="Bosun Adepoju" href={new URL('rss.xml', Astro.site)}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<!-- Without JS the reveal observer never runs, so every section below the
     hero would stay at opacity 0. !important because Astro injects the
     bundled stylesheet after this block, and .reveal there has equal
     specificity. -->
<noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>
</head>
<body>

<div class="wrap">

  <nav>
    <a class="brand" href={`${home}#top`}>bosun adepoju</a>
    <div class="routes">
      <a href={`${home}#work`}>/work</a>
      <a href={`${home}#content`}>/content</a>
      <a href={`${home}#now`}>/now</a>
    </div>
  </nav>

  <slot />

  <footer id="contact">
    <p class="route-marker">/contact</p>
    <p class="contact-line">The inbox is open: <a href="mailto:bosun@blacktagdevs.com">bosun@blacktagdevs.com</a></p>
    <div class="socials">
      {publishedSocials.map((link) => <a href={link.url} target="_blank" rel="me noopener">{link.label}</a>)}
    </div>
    <p class="colophon">built in atlanta · no trackers, no cookies</p>
  </footer>

</div>

<script is:inline>
  (function () {
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      var el = document.getElementById('typed');
      if (el) {
        var full = el.textContent;
        el.textContent = '';
        var i = 0;
        var type = function () {
          if (i <= full.length) {
            el.textContent = full.slice(0, i);
            i++;
            setTimeout(type, 55);
          }
        };
        setTimeout(type, 350);
      }
    }

    // threshold is 0 with a bottom rootMargin instead of a ratio: a ratio is a
    // fraction of the section, so a tall section on a narrow phone can never
    // reach it and would stay invisible. This fires once the section's top
    // clears the fold, whatever the section's height.
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0, rootMargin: '0px 0px -12% 0px' });
    document.querySelectorAll('.reveal').forEach(function (s) { obs.observe(s); });
  })();
</script>

</body>
</html>
