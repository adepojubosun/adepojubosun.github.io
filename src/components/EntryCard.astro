---
import { formatDate, entryHref } from '../lib/writing.js';

const { entry } = Astro.props;
const { title, description, pubDate, tags, format, thumbnail } = entry.data;
const isVideo = format === 'video';
const href = entryHref(entry);
---
<a class="card" href={href} {...isVideo ? { target: '_blank', rel: 'noopener' } : {}}>
  {isVideo && thumbnail && (
    <span class="card-thumb">
      <img src={thumbnail} alt="" loading="lazy" decoding="async" />
      <span class="card-play" aria-hidden="true">▶</span>
    </span>
  )}
  <div class="card-head">
    <span class="card-name">{title}</span>
    <span class="card-meta">{formatDate(pubDate)}{isVideo && ' · video ↗'}</span>
  </div>
  <p class="card-context">{description}</p>
  {tags.length > 0 && (
    <div class="tags">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  )}
</a>
