---
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import { getPublishedWriting } from '../../lib/writing.js';

const entries = await getPublishedWriting();
---
<Base
  title="Content — Bosun Adepoju"
  description="Writing and video on building software at scale."
>

  <section class="reveal">
    <p class="route-marker">/content</p>
    <p class="section-sub">Writing and video on building software at scale.</p>

    {entries.length === 0 ? (
      <div class="empty-state">
        <p><strong>First post ships September 2026.</strong> New writing every other week; video when it's ready.</p>
        <p>Topics: systems at scale, AI engineering, building products — and film, aviation, and whatever else, at random.</p>
        <div class="tags">
          <span class="tag">distributed systems</span><span class="tag">jvm</span><span class="tag">ai engineering</span><span class="tag">agentic tooling</span>
        </div>
      </div>
    ) : (
      entries.map((entry) => <EntryCard entry={entry} />)
    )}

    <div class="hero-links">
      <a href="/">← back home</a>
      <a href="/rss.xml">rss →</a>
    </div>
  </section>

</Base>
