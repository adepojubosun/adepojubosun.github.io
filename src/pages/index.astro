---
import Base from '../layouts/Base.astro';
import EntryCard from '../components/EntryCard.astro';
import { getPublishedWriting } from '../lib/writing.js';
import { publishedWork } from '../data/work.js';
import { publishedNow } from '../data/now.js';

const latest = (await getPublishedWriting()).slice(0, 3);
---
<Base
  title="Bosun Adepoju — I build things"
  description="Senior software engineer and CTO at BlackTagDevs. Multiple industries, one habit: solving the problem."
>

  <header id="top">
    <p class="eyebrow"><span class="dot">●</span> atlanta, ga</p>
    <h1>Bosun Adepoju</h1>
    <p class="tagline"><span id="typed">I build things.</span><span class="cursor" aria-hidden="true"></span></p>
    <p class="lede">Senior software engineer, and co-founder &amp; CTO at <a href="https://blacktagdevs.com" target="_blank" rel="noopener">BlackTagDevs</a>. Deep in computing systems and product development — fluent across everything around them.</p>
    <p class="lede">I've shipped in fintech, healthcare, telecom, and consumer products, lately with a lot of AI engineering in the mix. The common thread is the problem, not the stack.</p>
    <div class="hero-links">
      <a href="#work">selected work ↓</a>
      <a href="#contact">get in touch →</a>
    </div>
  </header>

  <section id="work" class="reveal">
    <p class="route-marker">/work</p>
    <p class="section-sub">Current and past work.</p>

    {publishedWork.map((card) => (
      <article class="card">
        <div class="card-head">
          <span class="card-name">
            {card.url ? (
              <a href={card.url} target="_blank" rel="noopener">{card.name}<span class="ext" aria-hidden="true">↗</span></a>
            ) : card.name}
          </span>
          {card.meta && <span class="card-meta">{card.meta}</span>}
        </div>
        <p class="card-context mono">{card.context}</p>
        <p class="body">{card.body}</p>
        <div class="tags">
          {card.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </article>
    ))}
  </section>

  <section id="writing" class="reveal">
    <p class="route-marker">/writing</p>
    <p class="section-sub">Notes on building software at scale.</p>
    {latest.length === 0 ? (
      <div class="empty-state">
        <p><strong>First post ships September 2026.</strong> Writing every other week after that.</p>
        <p>On the docket: systems at real scale, AI engineering past the hype, what running a company teaches you about writing software — and the occasional detour into whatever I'm watching, training for, or flying.</p>
        <div class="tags">
          <span class="tag">distributed systems</span><span class="tag">jvm</span><span class="tag">ai engineering</span><span class="tag">agentic tooling</span>
        </div>
      </div>
    ) : (
      <>
        {latest.map((entry) => <EntryCard entry={entry} />)}
        <div class="hero-links">
          <a href="/writing/">all writing →</a>
        </div>
      </>
    )}
  </section>

  <section id="now" class="reveal">
    <p class="route-marker">/now</p>
    <p class="section-sub">What has my attention right now.</p>
    <ul class="now-list">
      {publishedNow.map((row) => (
        <li><span class="now-key">{row.key}</span><span class="now-val">{row.value}</span></li>
      ))}
    </ul>
    <p class="updated">last updated: august 2026</p>
  </section>

  <section id="uses" class="reveal">
    <p class="route-marker">/uses</p>
    <p class="section-sub">The setup, kept deliberately simple.</p>
    <div class="uses-grid">
      <div class="uses-item">
        <p class="uses-label">machines</p>
        <p>Linux tower on Pop!_OS for builds and personal projects. MacBook for everything portable.</p>
      </div>
      <div class="uses-item">
        <p class="uses-label">stack</p>
        <p>Kotlin and Java on the JVM. TypeScript and React on the front end. Python for AI work and anything that needs to move fast. Docker, Tailscale, WireGuard underneath.</p>
      </div>
      <div class="uses-item">
        <p class="uses-label">ai tooling</p>
        <p>Claude Code, heavily. Custom MCP servers, agentic workflows, and strong opinions about both.</p>
      </div>
      <div class="uses-item">
        <p class="uses-label">principles</p>
        <p>Personal and work systems stay strictly separate. I would rather the infrastructure be dull.</p>
      </div>
    </div>
  </section>

</Base>
